# Copy to .env and adjust as needed. Every variable is documented here;
# nothing else is configured anywhere.

# --- Database (PostGIS) ---
# Used by the api service inside Docker and by scripts/load_data.py locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webgis

# Used by the db service in docker compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webgis

# --- Map (served to the frontend via GET /api/config) ---
MAP_CENTER_LAT=34.006
MAP_CENTER_LNG=71.974
MAP_ZOOM=13

# Study-area bounding box: minLng,minLat,maxLng,maxLat (Nowshera, KP by default).
# risk-check rejects points outside it; the shelter form does too.
STUDY_AREA_BBOX=71.85,33.90,72.10,34.12

# --- Click analysis ---
DEFAULT_RADIUS_M=3000
CAUTION_RADIUS_M=500

# --- CORS (comma-separated origins, no wildcard unless you set it) ---
CORS_ORIGINS=http://localhost:8000
